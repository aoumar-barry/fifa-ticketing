# ============================================================
# FIFA Ticketing Hub 2026 — Variables d'environnement (exemple)
# Copier ce fichier en .env (backend) et remplir les valeurs.
# Ne JAMAIS committer le .env réel.
# ============================================================

# --- Azure Cosmos DB (API MongoDB) ---
COSMOS_CONNECTION_STRING=
COSMOS_DB_NAME=fifa-ticketing

# --- Upstash Redis ---
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# --- JWT Secrets (Authentification locale) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Firebase (Admin & Frontend SDK) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Variables pour le Frontend React (utilisées avec Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Stripe (sandbox uniquement) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=tickets

# --- Azure Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
